<UserControl x:Class="VoiceIme.Views.AboutSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <!-- About section (redesign): page title, then read-only cards —
         appearance (theme, applies live), language, app facts
         (version, app-data/log folders, source), and acknowledgments.
         Every x:Name and event handler the code-behind relies on is
         preserved; brushes resolve from Theme/HandyTheme.xaml via
         DynamicResource. -->
    <StackPanel>
        <TextBlock Text="About" Style="{DynamicResource HandyPageTitle}" />
        <TextBlock Text="Theme, language, version, folders, and open-source credits."
                   Style="{DynamicResource HandyCaption}" />

        <!-- Appearance card -->
        <Border Style="{DynamicResource HandySettingCard}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="APPEARANCE" Style="{DynamicResource HandyCaptionSmall}"
                           Foreground="{DynamicResource HandyTextSecondary}" />
                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" MinWidth="200"
                              VerticalAlignment="Center" HorizontalAlignment="Right"
                              FontSize="13" Foreground="{DynamicResource HandyText}"
                              FontFamily="{DynamicResource HandyFontFamily}"
                              SelectionChanged="ThemeBox_SelectionChanged" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="System follows your Windows setting. Applies immediately."
                                   FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Language card -->
        <Border Style="{DynamicResource HandySettingCard}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="LANGUAGE" Style="{DynamicResource HandyCaptionSmall}"
                           Foreground="{DynamicResource HandyTextSecondary}" />
                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" MinWidth="200"
                              VerticalAlignment="Center" HorizontalAlignment="Right"
                              FontSize="13" Foreground="{DynamicResource HandyText}"
                              FontFamily="{DynamicResource HandyFontFamily}"
                              SelectionChanged="LanguageBox_SelectionChanged" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="App language" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="Only English is available so far — your choice is saved, and the app stays in English."
                                   FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- App card -->
        <Border Style="{DynamicResource HandySettingCard}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="APP" Style="{DynamicResource HandyCaptionSmall}"
                           Foreground="{DynamicResource HandyTextSecondary}" />
                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <TextBlock x:Name="VersionText" DockPanel.Dock="Right"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               FontSize="13" FontFamily="Consolas, Courier New"
                               Foreground="{DynamicResource HandyTextSecondary}" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Version" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="The installed app version."
                                   FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <Button x:Name="AppDataButton" DockPanel.Dock="Right"
                            VerticalAlignment="Center" HorizontalAlignment="Right"
                            Style="{DynamicResource HandySecondaryButton}"
                            Content="Open folder" Click="AppDataButton_Click" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="App data folder" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="Settings and history live here."
                                   FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <Button x:Name="LogFolderButton" DockPanel.Dock="Right"
                            VerticalAlignment="Center" HorizontalAlignment="Right"
                            Style="{DynamicResource HandySecondaryButton}"
                            Content="Open folder" Click="LogFolderButton_Click" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Log folder" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="Diagnostic logs live here. Never include API keys."
                                   FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <Button x:Name="SourceLinkButton" DockPanel.Dock="Right"
                            VerticalAlignment="Center" HorizontalAlignment="Right"
                            Style="{DynamicResource HandySecondaryButton}"
                            Content="View on GitHub" Click="SourceLinkButton_Click" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Source code" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="VoiceIme is open source."
                                   FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Acknowledgments card -->
        <Border Style="{DynamicResource HandySettingCard}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="ACKNOWLEDGMENTS" Style="{DynamicResource HandyCaptionSmall}"
                           Foreground="{DynamicResource HandyTextSecondary}" />
                <TextBlock FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                           TextWrapping="Wrap">
                    ggml — Voice IME's local speech-to-text builds on transcribe.cpp
                    and ggml. Thanks to Georgi Gerganov and contributors.
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
