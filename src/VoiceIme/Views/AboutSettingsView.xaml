<UserControl x:Class="VoiceIme.Views.AboutSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <!-- About section (Handy AboutSettings port, read-only-safe subset):
         Appearance group (theme dropdown: system/light/dark, applies live via
         ThemeManager), Language group (English-only catalog in v1 — selection
         persists, UI stays English, labeled honestly), App group (version row
         in mono, app-data + log-folder buttons, source link), Acknowledgments
         group (runtime and dependency credit). Donate is intentionally absent.
         All brushes and the card/row/button styles resolve from
         Theme/HandyTheme.xaml via DynamicResource. Hosted by MainWindow
         through RegisterSectionView(MainSection.About, view). -->
    <StackPanel>
        <TextBlock Text="APPEARANCE" Style="{DynamicResource HandyGroupHeader}" Margin="0,0,0,8" />
        <Border Style="{DynamicResource HandySettingCard}">
            <StackPanel>
                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" MinWidth="200"
                              VerticalAlignment="Center" HorizontalAlignment="Right"
                              FontSize="13" Foreground="{DynamicResource HandyText}"
                              FontFamily="{DynamicResource HandyFontFamily}"
                              SelectionChanged="ThemeBox_SelectionChanged" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="System follows your Windows setting. Applies immediately."
                                   FontSize="12" Foreground="{DynamicResource HandyMidGray}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="LANGUAGE" Style="{DynamicResource HandyGroupHeader}" />
        <Border Style="{DynamicResource HandySettingCard}">
            <StackPanel>
                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" MinWidth="200"
                              VerticalAlignment="Center" HorizontalAlignment="Right"
                              FontSize="13" Foreground="{DynamicResource HandyText}"
                              FontFamily="{DynamicResource HandyFontFamily}"
                              SelectionChanged="LanguageBox_SelectionChanged" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="App language" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="Only English is available so far — your choice is saved, and the app stays in English."
                                   FontSize="12" Foreground="{DynamicResource HandyMidGray}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="APP" Style="{DynamicResource HandyGroupHeader}" />
        <Border Style="{DynamicResource HandySettingCard}">
            <StackPanel>
                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <TextBlock x:Name="VersionText" DockPanel.Dock="Right"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               FontSize="13" FontFamily="Consolas, Courier New"
                               Foreground="{DynamicResource HandyMidGray}" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Version" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="The installed app version."
                                   FontSize="12" Foreground="{DynamicResource HandyMidGray}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <Button x:Name="AppDataButton" DockPanel.Dock="Right"
                            VerticalAlignment="Center" HorizontalAlignment="Right"
                            Style="{DynamicResource HandySecondaryButton}"
                            Content="Open folder" Click="AppDataButton_Click" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="App data folder" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="Settings and history live here."
                                   FontSize="12" Foreground="{DynamicResource HandyMidGray}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <Button x:Name="LogFolderButton" DockPanel.Dock="Right"
                            VerticalAlignment="Center" HorizontalAlignment="Right"
                            Style="{DynamicResource HandySecondaryButton}"
                            Content="Open folder" Click="LogFolderButton_Click" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Log folder" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="Diagnostic logs live here. Never include API keys."
                                   FontSize="12" Foreground="{DynamicResource HandyMidGray}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <Button x:Name="SourceLinkButton" DockPanel.Dock="Right"
                            VerticalAlignment="Center" HorizontalAlignment="Right"
                            Style="{DynamicResource HandySecondaryButton}"
                            Content="View on GitHub" Click="SourceLinkButton_Click" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Source code" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="VoiceIme is open source."
                                   FontSize="12" Foreground="{DynamicResource HandyMidGray}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="ACKNOWLEDGMENTS" Style="{DynamicResource HandyGroupHeader}" />
        <Border Style="{DynamicResource HandySettingCard}">
            <StackPanel>
                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Project" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="Voice IME uses NAudio for Windows capture/playback, WPF and WinForms for the UI, and the configured Gemini-compatible transcription endpoint."
                                   FontSize="12" Foreground="{DynamicResource HandyMidGray}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
