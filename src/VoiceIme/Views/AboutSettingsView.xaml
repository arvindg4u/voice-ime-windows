<UserControl x:Class="VoiceIme.Views.AboutSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">

    <!--
      About.

      Two content fixes:

      • The language dropdown was a dead control — one item ("English") that
        persisted and changed nothing, occupying an entire group. A control that
        cannot act is noise; the fact is now stated once in a note, and the
        setting stays in the store for a future real implementation.
      • The acknowledgments credited transcribe.cpp/ggml, which is the *Handy*
        project's local model engine. This app transcribes through the Gemini
        API and contains no ggml code, so the credit was simply wrong. It now
        credits what this build actually uses.

      The accent swatch row is new: it shows the selected theme across real
      surfaces rather than only restyling the surrounding chrome, so a user can
      see the palette they are choosing.
    -->

    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="56" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style x:Key="RowHelp" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <!-- ==================== APPEARANCE ==================== -->
        <TextBlock Text="APPEARANCE" Style="{DynamicResource GroupHeader}" Margin="0,0,0,8" />

        <Border Style="{DynamicResource Card}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Theme" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHelp}"
                                   Text="System follows your Windows app setting and updates live when you change it." />
                    </StackPanel>
                    <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="200"
                              VerticalAlignment="Center"
                              Style="{DynamicResource InputComboBox}"
                              AutomationProperties.Name="Application theme"
                              SelectionChanged="ThemeBox_SelectionChanged" />
                </Grid>

                <Border Style="{StaticResource RowDivider}" />

                <!-- A small preview of the palette in use, so the choice is
                     visible without closing the dialog. -->
                <StackPanel Margin="0,8,0,4">
                    <TextBlock Text="Preview" Style="{StaticResource RowHelp}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Border Width="72" Height="48" CornerRadius="8" Margin="0,0,8,0"
                                Background="{DynamicResource SurfaceCard}"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                            <TextBlock Text="Aa" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource UiFontFamily}" FontSize="14"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </Border>
                        <Border Width="72" Height="48" CornerRadius="8" Margin="0,0,8,0"
                                Background="{DynamicResource AccentFill}">
                            <TextBlock Text="Aa" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource UiFontFamily}" FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource OnAccent}" />
                        </Border>
                        <Border Width="72" Height="48" CornerRadius="8" Margin="0,0,8,0"
                                Background="{DynamicResource AccentSubtle}"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                            <TextBlock Text="Aa" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource UiFontFamily}" FontSize="14"
                                       Foreground="{DynamicResource AccentInk}" />
                        </Border>
                        <Border Width="72" Height="48" CornerRadius="8"
                                Background="{DynamicResource ErrorSurface}"
                                BorderBrush="{DynamicResource ErrorText}" BorderThickness="1">
                            <TextBlock Text="Aa" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource UiFontFamily}" FontSize="14"
                                       Foreground="{DynamicResource ErrorText}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="ContrastNote" Style="{StaticResource RowHelp}"
                               Margin="0,8,0,0"
                               Text="Every colour pair in this theme meets WCAG AA or better." />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ==================== PRIVACY ==================== -->
        <TextBlock Text="PRIVACY" Style="{DynamicResource GroupHeader}" />

        <Border Style="{DynamicResource Card}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Where your audio goes" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHelp}"
                                   Text="Speech is sent to Google's Gemini API to be transcribed. Audio is held in memory only, never written to disk, and discarded as soon as the transcript comes back." />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource RowDivider}" />

                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="What is stored on this PC" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHelp}"
                                   Text="Your API keys (encrypted with your Windows account) and the transcript history below. Nothing is uploaded except the audio being transcribed." />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== APP ==================== -->
        <TextBlock Text="APP" Style="{DynamicResource GroupHeader}" />

        <Border Style="{DynamicResource Card}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Version" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHelp}"
                                   Text="The installed build. Updates are delivered through GitHub releases." />
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Grid.Column="1" VerticalAlignment="Center"
                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="13"
                               Foreground="{DynamicResource TextSecondary}" />
                </Grid>

                <Border Style="{StaticResource RowDivider}" />

                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="App data" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHelp}"
                                   Text="Settings, API keys and history. Plain transcripts are not encrypted." />
                    </StackPanel>
                    <Button x:Name="AppDataButton" Grid.Column="1" VerticalAlignment="Center"
                            Style="{DynamicResource SecondaryButton}"
                            AutomationProperties.Name="Open the app data folder"
                            Content="Open folder" Click="AppDataButton_Click" />
                </Grid>

                <Border Style="{StaticResource RowDivider}" />

                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Diagnostic logs" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHelp}"
                                   Text="A local log of what the app did. API keys are never written to it." />
                    </StackPanel>
                    <Button x:Name="LogFolderButton" Grid.Column="1" VerticalAlignment="Center"
                            Style="{DynamicResource SecondaryButton}"
                            AutomationProperties.Name="Open the diagnostic log folder"
                            Content="Open folder" Click="LogFolderButton_Click" />
                </Grid>

                <Border Style="{StaticResource RowDivider}" />

                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Source code" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHelp}"
                                   Text="Voice IME is open source." />
                    </StackPanel>
                    <Button x:Name="SourceLinkButton" Grid.Column="1" VerticalAlignment="Center"
                            Style="{DynamicResource SecondaryButton}"
                            AutomationProperties.Name="View the source code on GitHub"
                            Content="View on GitHub" Click="SourceLinkButton_Click" />
                </Grid>

                <Border Style="{StaticResource RowDivider}" />

                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Language" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHelp}"
                                   Text="English is the only language available so far." />
                    </StackPanel>
                    <!-- Present but disabled: the selection is a real stored
                         preference, so it stays visible and truthful rather than
                         vanishing. Disabled is honest; a one-item dropdown that
                         looks operable is not. -->
                    <ComboBox x:Name="LanguageBox" Grid.Column="1" Width="200"
                              VerticalAlignment="Center" IsEnabled="False"
                              Style="{DynamicResource InputComboBox}"
                              AutomationProperties.Name="Application language. Only English is available."
                              AutomationProperties.HelpText="More languages will follow. The current build is English only."
                              SelectionChanged="LanguageBox_SelectionChanged" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== CREDITS ==================== -->
        <TextBlock Text="CREDITS" Style="{DynamicResource GroupHeader}" />

        <Border Style="{DynamicResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource RowHelp}"
                           TextWrapping="Wrap"
                           Text="Transcription is provided by the Google Gemini API. Audio capture uses NAudio. The interface follows Fluent design guidance for Windows 11." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>