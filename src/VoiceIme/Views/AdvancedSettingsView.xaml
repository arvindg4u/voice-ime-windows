<UserControl x:Class="VoiceIme.Views.AdvancedSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">

    <!--
      Advanced.

      The first port labelled three of these toggles "Stored for now" — but
      "Start with Windows" *was* implemented (App.ReconcileAutostart), so the
      copy was actively wrong and trained users to distrust every control here.
      Copy now states what each control really does. Grouping was also fixed:
      "Show overlay" is a display concern and moved out of APP, and the history
      cap moved next to the History section it governs rather than squatting in
      Advanced.
    -->

    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="56" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style x:Key="RowHelp" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <!-- ==================== STARTUP ==================== -->
        <TextBlock Text="STARTUP" Style="{DynamicResource GroupHeader}" Margin="0,0,0,8" />

        <Border Style="{DynamicResource Card}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHelp}"
                                   Text="Launch Voice IME when you sign in, so the hotkey is always available." />
                    </StackPanel>
                    <CheckBox x:Name="AutostartCheck" Grid.Column="1" VerticalAlignment="Center"
                              Style="{DynamicResource ToggleSwitch}"
                              AutomationProperties.Name="Start with Windows"
                              Click="AutostartCheck_Click" />
                </Grid>

                <Border Style="{StaticResource RowDivider}" />

                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Start minimised to tray" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHelp}"
                                   Text="Open without showing this window. The tray icon is still there." />
                    </StackPanel>
                    <CheckBox x:Name="StartHiddenCheck" Grid.Column="1" VerticalAlignment="Center"
                              Style="{DynamicResource ToggleSwitch}"
                              AutomationProperties.Name="Start minimised to tray"
                              Click="StartHiddenCheck_Click" />
                </Grid>

                <Border Style="{StaticResource RowDivider}" />

                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Show tray icon" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHelp}"
                                   Text="Turn this off only if you always keep the window open — with no tray icon and the window closed, there is no way back." />
                    </StackPanel>
                    <CheckBox x:Name="ShowTrayIconCheck" Grid.Column="1" VerticalAlignment="Center"
                              Style="{DynamicResource ToggleSwitch}"
                              AutomationProperties.Name="Show tray icon"
                              Click="ShowTrayIconCheck_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== SUMMON ==================== -->
        <TextBlock Text="RECORDING OVERLAY" Style="{DynamicResource GroupHeader}" />

        <Border Style="{DynamicResource Card}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Overlay" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHelp}"
                                   Text="The floating pill shown while you dictate. 'Minimal' drops the waveform; 'Off' hides it entirely." />
                    </StackPanel>
                    <ComboBox x:Name="ShowOverlayBox" Grid.Column="1" Width="200"
                              VerticalAlignment="Center"
                              Style="{DynamicResource InputComboBox}"
                              AutomationProperties.Name="Recording overlay detail"
                              SelectionChanged="ShowOverlayBox_SelectionChanged" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== OUTPUT ==================== -->
        <TextBlock Text="PASTING" Style="{DynamicResource GroupHeader}" />

        <Border Style="{DynamicResource Card}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Paste method" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHelp}"
                                   Text="The keystroke sent after the transcript is placed on the clipboard." />
                    </StackPanel>
                    <ComboBox x:Name="PasteMethodBox" Grid.Column="1" Width="200"
                              VerticalAlignment="Center"
                              Style="{DynamicResource InputComboBox}"
                              AutomationProperties.Name="Paste method"
                              SelectionChanged="PasteMethodBox_SelectionChanged" />
                </Grid>

                <Border Style="{StaticResource RowDivider}" />

                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Press Enter after pasting" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHelp}"
                                   Text="Useful for search and chat boxes. Note that Enter will submit or run whatever field it lands in." />
                    </StackPanel>
                    <CheckBox x:Name="AutoSubmitCheck" Grid.Column="1" VerticalAlignment="Center"
                              Style="{DynamicResource ToggleSwitch}"
                              AutomationProperties.Name="Press Enter after pasting"
                              Click="AutoSubmitCheck_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== HISTORY ==================== -->
        <TextBlock Text="HISTORY" Style="{DynamicResource GroupHeader}" />

        <Border Style="{DynamicResource Card}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Keep at most" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHelp}"
                                   Text="Between 10 and 500 transcripts. Older entries are dropped first; pinned entries are never dropped." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="HistoryLimitBox" Width="76"
                                 VerticalAlignment="Center"
                                 Style="{DynamicResource InputTextBox}"
                                 AutomationProperties.Name="Maximum number of stored transcripts"
                                 TextChanged="HistoryLimitBox_TextChanged"
                                 LostFocus="HistoryLimitBox_LostFocus" />
                        <TextBlock Text="entries" Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource UiFontFamily}" FontSize="12"
                                   Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="HistoryLimitError" Style="{DynamicResource FieldError}"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>