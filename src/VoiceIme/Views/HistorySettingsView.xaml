<UserControl x:Class="VoiceIme.Views.HistorySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">

    <!--
      History.

      Changes over the first port:

      • Rows were op.6 for failed items, which put already-muted text far below
        the contrast floor; failure is now conveyed by a red status chip and an
        icon, not by fading the whole card.
      • Action buttons gained accessible names and icon glyphs. The old row used
        "⧉ / ★ / Retry / Delete" text buttons whose only identity was a tooltip.
      • Delete and Clear now confirm. Both were destructive with no undo.
      • The empty state is a real empty state with a next step, and the footer
        hint is gone when there is nothing to act on.
      • Rows are flattened (list-row padding, no nested card) so a long history
        does not look like a stack of boxes.
    -->

    <UserControl.Resources>
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="RowAction" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisualRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource SurfaceHover}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- ==================== HEADER ==================== -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="History" Style="{DynamicResource TextTitle}" />
                <TextBlock x:Name="CountText" Style="{DynamicResource StatusText}"
                           Margin="0,2,0,0" Text="Transcripts stay on this PC." />
            </StackPanel>
            <Button x:Name="OpenFolderButton" Grid.Column="1" VerticalAlignment="Center"
                    Style="{DynamicResource SecondaryButton}"
                    AutomationProperties.Name="Open the Voice IME data folder"
                    ToolTip="Open the Voice IME data folder in Explorer"
                    Click="OpenFolderButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"
                               Text="&#xE8B7;" />
                    <TextBlock Text="Open folder" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ==================== EMPTY STATE ==================== -->
        <Border x:Name="EmptyState" DockPanel.Dock="Top" Style="{DynamicResource Card}"
                Visibility="Collapsed" Padding="32">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28"
                           Text="&#xE81C;" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextDisabled}" />
                <TextBlock Text="No transcripts yet" Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="{DynamicResource UiFontFamily}" FontSize="14"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="Press your dictation hotkey and speak. What you say lands here."
                           Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="320"
                           FontFamily="{DynamicResource UiFontFamily}" FontSize="12"
                           Foreground="{DynamicResource TextMuted}" />
            </StackPanel>
        </Border>

        <!-- ==================== FOOTER ==================== -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="HintIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource TextMuted}" Text="" />
                <TextBlock x:Name="HintText" VerticalAlignment="Center"
                           FontFamily="{DynamicResource UiFontFamily}" FontSize="12"
                           TextWrapping="Wrap" MaxWidth="420"
                           Foreground="{DynamicResource TextMuted}" Text=""
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <Button x:Name="ClearButton" Grid.Column="1" VerticalAlignment="Center"
                    Style="{DynamicResource SecondaryButton}"
                    AutomationProperties.Name="Delete all unpinned transcripts"
                    Content="Clear unpinned"
                    Click="ClearButton_Click" />
        </Grid>

        <!-- ==================== LIST ==================== -->
        <ListBox x:Name="EntriesList" Style="{DynamicResource HistoryList}"
                 AutomationProperties.Name="Transcript history">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- One flat row: no card inside the list item. -->
                    <Border Padding="12,10" CornerRadius="8"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderSubtle}"
                            Background="{DynamicResource SurfaceCard}"
                            ToolTip="{Binding CompactLabel}">
                        <StackPanel>

                            <!-- Meta row: time + status chip, so a failed entry
                                 reads as failed without dimming the text. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TimeLabel}"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" />
                                <Border Grid.Column="1" CornerRadius="4" Padding="6,2"
                                        Visibility="{Binding ErrorVisibility}"
                                        Background="{DynamicResource ErrorSurface}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="10" VerticalAlignment="Center"
                                                   Margin="0,0,4,0" Text="&#xEA39;"
                                                   Foreground="{DynamicResource ErrorText}" />
                                        <TextBlock Text="Failed"
                                                   FontFamily="{DynamicResource UiFontFamily}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ErrorText}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBox Text="{Binding Body, Mode=OneWay}" Margin="0,6,0,0"
                                     Style="{DynamicResource SelectableText}"
                                     Visibility="{Binding BodyVisibility}" />

                            <TextBlock Text="{Binding Error, Mode=OneWay}" Margin="0,6,0,0"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ErrorText}"
                                       Visibility="{Binding ErrorVisibility}" />

                            <!-- Actions -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource RowAction}"
                                        Tag="{Binding Id}"
                                        Visibility="{Binding CopyVisibility}"
                                        AutomationProperties.Name="Copy transcript to clipboard"
                                        ToolTip="Copy to clipboard"
                                        Click="CopyButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8C8;" />
                                        <TextBlock Text="Copy" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource RowAction}"
                                        Tag="{Binding Id}"
                                        AutomationProperties.Name="{Binding PinActionName}"
                                        ToolTip="{Binding PinTip}"
                                        Click="PinButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconGlyph}"
                                                   Text="{Binding PinGlyph}" />
                                        <TextBlock Text="{Binding PinActionLabel}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource RowAction}"
                                        Tag="{Binding Id}"
                                        Visibility="{Binding RetryVisibility}"
                                        AutomationProperties.Name="Re-dictate this entry"
                                        ToolTip="Audio isn't kept, so retry means dictating again"
                                        Click="RetryButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;" />
                                        <TextBlock Text="Retry" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource RowAction}"
                                        Tag="{Binding Id}"
                                        AutomationProperties.Name="Delete this transcript"
                                        ToolTip="Delete this transcript"
                                        Click="DeleteButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconGlyph}"
                                                   Text="&#xE74D;"
                                                   Foreground="{DynamicResource ErrorText}" />
                                        <TextBlock Text="Delete" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ErrorText}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>