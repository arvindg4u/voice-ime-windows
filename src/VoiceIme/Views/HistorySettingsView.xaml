<UserControl x:Class="VoiceIme.Views.HistorySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <!-- History section (redesign): header row with Open folder, then the
         newest-first transcript list — each entry a card with a medium
         timestamp, selectable italic transcript, and a copy/pin/retry/delete
         row. Failed transcriptions render muted with an inline error and a
         re-dictate hint (audio is never persisted). Every x:Name and event
         handler the code-behind relies on is preserved; brushes resolve from
         Theme/HandyTheme.xaml via DynamicResource. -->
    <StackPanel>
        <DockPanel LastChildFill="False" Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Left" Text="History" VerticalAlignment="Center"
                       Margin="0" Style="{DynamicResource HandyPageTitle}" />
            <Button x:Name="OpenFolderButton" DockPanel.Dock="Right" Content="Open folder"
                    Padding="12,8" VerticalAlignment="Center"
                    Style="{DynamicResource HandySecondaryButton}"
                    ToolTip="Open the Voice IME data folder in Explorer"
                    Click="OpenFolderButton_Click" />
        </DockPanel>

        <ListBox x:Name="EntriesList"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,0,0,10" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{DynamicResource HandyFocusVisual}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource HandySettingCard}"
                            Opacity="{Binding CardOpacity}"
                            ToolTip="{Binding CompactLabel}">
                        <StackPanel>
                        <TextBlock Text="{Binding TimeLabel}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource HandyText}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding Body, Mode=OneWay}" Margin="0,6,0,0"
                                     IsReadOnly="True" BorderThickness="0"
                                     Background="Transparent"
                                     FontStyle="Italic" FontSize="14"
                                     TextWrapping="Wrap"
                                     Foreground="{DynamicResource HandyText}"
                                     Visibility="{Binding BodyVisibility}" />
                            <TextBlock Text="{Binding Error, Mode=OneWay}" Margin="0,6,0,0"
                                       FontStyle="Italic" FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource HandyError}"
                                       Visibility="{Binding ErrorVisibility}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{Binding CopyGlyph}" Padding="10,6" Margin="0,0,8,0"
                                        Style="{DynamicResource HandySecondaryButton}"
                                        Tag="{Binding Id}" ToolTip="Copy to clipboard"
                                        Visibility="{Binding CopyVisibility}"
                                        Click="CopyButton_Click" />
                                <Button Content="{Binding RePasteGlyph}" Padding="10,6" Margin="0,0,8,0"
                                        Style="{DynamicResource HandySecondaryButton}"
                                        Tag="{Binding Id}" ToolTip="Paste this transcript into the focused window again"
                                        Visibility="{Binding RePasteVisibility}"
                                        Click="RePasteButton_Click" />
                                <Button Content="{Binding PinGlyph}" Padding="10,6" Margin="0,0,8,0"
                                        Style="{DynamicResource HandySecondaryButton}"
                                        Tag="{Binding Id}" ToolTip="{Binding PinTip}"
                                        Click="PinButton_Click" />
                                <Button Content="Retry" Padding="10,6" Margin="0,0,8,0"
                                        Style="{DynamicResource HandySecondaryButton}"
                                        Tag="{Binding Id}"
                                        ToolTip="Audio isn't kept — re-dictate instead"
                                        Visibility="{Binding RetryVisibility}"
                                        Click="RetryButton_Click" />
                                <Button Content="Delete" Padding="10,6"
                                        Style="{DynamicResource HandyDangerButton}"
                                        Tag="{Binding Id}"
                                        Click="DeleteButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyText" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource HandyTextSecondary}"
                   Text="No history yet — dictate something first."
                   Visibility="Collapsed" />

        <DockPanel Margin="0,16,0,0">
            <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Clear unpinned"
                    Padding="12,8" VerticalAlignment="Center"
                    Style="{DynamicResource HandySecondaryButton}"
                    Click="ClearButton_Click" />
            <TextBlock x:Name="HintText" VerticalAlignment="Center" Margin="0,0,12,0"
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource HandyTextSecondary}" />
        </DockPanel>
    </StackPanel>
</UserControl>
