<UserControl x:Class="VoiceIme.Views.GeminiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">

    <!--
      Speech (transcription provider).

      Layout fixes over the first port:

      • One row grammar, matching General/Advanced/About. This screen alone used
        stacked "label above field" while every other screen used label-left /
        control-right, so the same app had two different row metaphors.
      • Two "Save" buttons became one. Previously "Save" (API fields) and
        "Save" (named prompt) sat on the same screen and did different things.
      • The API keys field is monospaced, masked-capable and reports how many
        keys it holds, instead of being an unlabelled `<TextBox>`.
      • Reset is confirmed, because it silently wiped the whole prompt library.
      • Status is a severity-coloured inline message next to the actions, not a
        bare grey line at the bottom of the scroll region.
    -->

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style x:Key="FieldHelp" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="56" />
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <!-- ==================== CONNECTION ==================== -->
        <TextBlock Text="CONNECTION" Style="{DynamicResource GroupHeader}" Margin="0,0,0,8" />

        <Border Style="{DynamicResource Card}">
            <StackPanel>

                <!-- API keys -->
                <StackPanel Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="API keys" Style="{StaticResource FieldLabel}" />
                            <TextBlock Style="{StaticResource FieldHelp}"
                                       Text="One per line. Keys rotate automatically when one is rate-limited." />
                        </StackPanel>
                        <TextBlock x:Name="KeyCountText" Grid.Column="1" VerticalAlignment="Bottom"
                                   FontFamily="{DynamicResource UiFontFamily}" FontSize="12"
                                   Foreground="{DynamicResource TextMuted}" Text="" />
                    </Grid>
                    <TextBox x:Name="KeysBox" Margin="0,6,0,0" Height="92"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                             Style="{DynamicResource InputTextBox}"
                             AutomationProperties.Name="Gemini API keys, one per line"
                             AutomationProperties.HelpText="Keys are encrypted on this PC with your Windows account." />
                    <TextBlock Style="{StaticResource FieldHelp}"
                               Text="Stored encrypted with Windows DPAPI and never written to logs." />
                </StackPanel>

                <!-- Model -->
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Model" Style="{StaticResource FieldLabel}" />
                        <TextBlock Style="{StaticResource FieldHelp}"
                                   Text="The Gemini model used for transcription." />
                    </StackPanel>
                    <TextBox x:Name="ModelBox" Grid.Column="1" Width="240"
                             VerticalAlignment="Center"
                             Style="{DynamicResource InputTextBox}"
                             AutomationProperties.Name="Transcription model" />
                </Grid>

                <!-- Base URL (advanced-ish, but part of the connection) -->
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Base URL" Style="{StaticResource FieldLabel}" />
                        <TextBlock Style="{StaticResource FieldHelp}"
                                   Text="Only change this if you route through a proxy." />
                    </StackPanel>
                    <TextBox x:Name="BaseUrlBox" Grid.Column="1" Width="240"
                             VerticalAlignment="Center"
                             Style="{DynamicResource InputTextBox}"
                             AutomationProperties.Name="API base URL" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== CUSTOM PROMPT ==================== -->
        <TextBlock Text="CUSTOM PROMPT" Style="{DynamicResource GroupHeader}" />

        <Border Style="{DynamicResource Card}">
            <StackPanel>

                <!-- Named prompts -->
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Saved prompt" Style="{StaticResource FieldLabel}" />
                        <TextBlock Style="{StaticResource FieldHelp}"
                                   Text="Pick a saved prompt to load it into the editor." />
                    </StackPanel>
                    <ComboBox x:Name="PromptSelector" Grid.Column="1" Width="240"
                              VerticalAlignment="Center"
                              Style="{DynamicResource InputComboBox}"
                              AutomationProperties.Name="Saved prompt"
                              SelectionChanged="PromptSelector_SelectionChanged" />
                </Grid>

                <Border Style="{DynamicResource Divider}" />

                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Prompt name" Style="{StaticResource FieldLabel}" />
                    <TextBlock Style="{StaticResource FieldHelp}"
                               Text="Up to 60 characters. Saving under an existing name updates it." />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PromptNameBox" Grid.Column="0"
                                 Style="{DynamicResource InputTextBox}"
                                 AutomationProperties.Name="Prompt name" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="8,0,0,0">
                            <Button x:Name="SavePromptButton" Content="Save prompt"
                                    Style="{DynamicResource SecondaryButton}"
                                    AutomationProperties.Name="Save prompt under this name"
                                    Click="SavePromptButton_Click" />
                            <Button x:Name="DeletePromptButton" Content="Delete" Margin="8,0,0,0"
                                    Style="{DynamicResource SecondaryButton}"
                                    AutomationProperties.Name="Delete the selected saved prompt"
                                    Click="DeletePromptButton_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Prompt text" Style="{StaticResource FieldLabel}" />
                            <TextBlock Style="{StaticResource FieldHelp}"
                                       Text="Sent as the system instruction with every transcription. Leave blank to disable." />
                        </StackPanel>
                        <TextBlock x:Name="PromptHint" Grid.Column="1" VerticalAlignment="Bottom"
                                   FontFamily="{DynamicResource UiFontFamily}" FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   Text="0/2000 characters"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                    <TextBox x:Name="PromptBox" Margin="0,6,0,0" MinHeight="104"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Style="{DynamicResource InputTextBox}"
                             AutomationProperties.Name="Custom prompt text"
                             TextChanged="PromptBox_TextChanged" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ==================== ACTIONS ==================== -->
        <Border Style="{DynamicResource Card}" Margin="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status sits beside the buttons so feedback appears where the
                     user's eye already is when they click. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextMuted}" Text="" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                               FontFamily="{DynamicResource UiFontFamily}" FontSize="12"
                               TextWrapping="Wrap" MaxWidth="360"
                               Foreground="{DynamicResource TextMuted}" Text=""
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ResetButton" Content="Reset"
                            Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"
                            AutomationProperties.Name="Reset connection, model and prompt to defaults"
                            ToolTip="Restore the default base URL, model and prompt. Your API keys are kept."
                            Click="ResetButton_Click" />
                    <Button x:Name="TestButton" Content="Test connection"
                            Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"
                            AutomationProperties.Name="Test the transcription connection"
                            ToolTip="Sends a short tone through the full transcription pipeline"
                            Click="TestButton_Click" />
                    <Button x:Name="SaveButton" Content="Save"
                            Style="{DynamicResource PrimaryButton}" IsDefault="True"
                            AutomationProperties.Name="Save connection settings"
                            Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Style="{DynamicResource StatusText}" Margin="4,10,0,0"
                   Text="Changes here are saved only when you press Save." />
    </StackPanel>
</UserControl>