<UserControl x:Class="VoiceIme.Views.GeminiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <!-- Gemini section (Handy post-processing API group port): Handy's
         provider/model pickers are replaced by our fixed Gemini fields —
         stacked Base URL, API keys, and Model with reset-to-defaults, then
         the custom-prompt group (multi-line editor, char-count hint, tip),
         then the Test/Save footer with inline status. All brushes and styles
         resolve from Theme/HandyTheme.xaml via DynamicResource. Hosted by
         MainWindow through RegisterSectionView(MainSection.Gemini, view). -->
    <StackPanel>
        <TextBlock Text="GEMINI API" Style="{DynamicResource HandyGroupHeader}" Margin="0,0,0,8" />
        <Border Style="{DynamicResource HandySettingCard}">
            <StackPanel>
                <TextBlock Text="Base URL" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource HandyText}" />
                <TextBox x:Name="BaseUrlBox" Margin="0,4,0,12"
                         Style="{DynamicResource HandyTextBox}" />

                <TextBlock Text="API keys" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource HandyText}" />
                <TextBlock Text="One per line — auto-rotates on rate limit."
                           FontSize="12" Foreground="{DynamicResource HandyMidGray}"
                           TextWrapping="Wrap" />
                <TextBox x:Name="KeysBox" Margin="0,4,0,12" Height="90"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         Style="{DynamicResource HandyTextBox}" />

                <TextBlock Text="Model" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource HandyText}" />
                <TextBox x:Name="ModelBox" Margin="0,4,0,8"
                         Style="{DynamicResource HandyTextBox}" />
                <Button x:Name="ResetButton" Content="Reset to defaults"
                        HorizontalAlignment="Left" Padding="12,4"
                        Style="{DynamicResource HandySecondaryButton}"
                        ToolTip="Restore the default Base URL, model, and prompt (keys are kept)"
                        Click="ResetButton_Click" />
            </StackPanel>
        </Border>

        <TextBlock Text="CUSTOM PROMPT" Style="{DynamicResource HandyGroupHeader}" />
        <Border Style="{DynamicResource HandySettingCard}">
            <StackPanel>
                <TextBlock Text="Custom prompt (max 2000 chars, blank to disable)"
                           FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource HandyText}" />
                <TextBox x:Name="PromptBox" Margin="0,4,0,4" MinHeight="100"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Style="{DynamicResource HandyTextBox}"
                         TextChanged="PromptBox_TextChanged" />
                <TextBlock x:Name="PromptHint" FontSize="12"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource HandyMidGray}"
                           Text="0/2000 characters" />
                <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource HandyMidGray}"
                           Text="Tip: blank disables the custom prompt. Otherwise the text is sent as the system instruction with every transcription." />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="TestButton" Content="Test" Width="90" Margin="0,0,8,0"
                    Style="{DynamicResource HandyPrimaryButton}"
                    ToolTip="Send a test tone through the full pipeline"
                    Click="TestButton_Click" />
            <Button x:Name="SaveButton" Content="Save" Width="90" IsDefault="True"
                    Style="{DynamicResource HandySecondaryButton}"
                    Click="SaveButton_Click" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource HandyMidGray}" />
    </StackPanel>
</UserControl>
