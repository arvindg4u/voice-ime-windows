<UserControl x:Class="VoiceIme.Views.GeminiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <!-- Gemini section (redesign): page title, an API card (Base URL, API
         keys, Model, reset-to-defaults) and a prompt-library card (saved
         prompt picker, editor with char count, Save/Delete), then the
         Test/Save footer with inline status. Every x:Name and event handler
         the code-behind relies on is preserved. Brushes resolve from
         Theme/HandyTheme.xaml via DynamicResource. -->
    <StackPanel>
        <TextBlock Text="Gemini API" Style="{DynamicResource HandyPageTitle}" />
        <TextBlock Text="Base URL, API keys, model, and the custom system prompt sent with every transcription."
                   Style="{DynamicResource HandyCaption}" />

        <!-- API card -->
        <Border Style="{DynamicResource HandySettingCard}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="API" Style="{DynamicResource HandyCaptionSmall}"
                           Foreground="{DynamicResource HandyTextSecondary}" />

                <TextBlock Text="Base URL" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource HandyText}" />
                <TextBox x:Name="BaseUrlBox" Margin="0,4,0,12"
                         Style="{DynamicResource HandyTextBox}" />

                <TextBlock Text="API keys" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource HandyText}" />
                <TextBlock Text="One per line — auto-rotates on rate limit."
                           FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                           TextWrapping="Wrap" />
                <TextBox x:Name="KeysBox" Margin="0,4,0,12" Height="90"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         Style="{DynamicResource HandyTextBox}" />

                <TextBlock Text="Model" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource HandyText}" />
                <TextBox x:Name="ModelBox" Margin="0,4,0,8"
                         Style="{DynamicResource HandyTextBox}" />
                <Button x:Name="ResetButton" Content="Reset to defaults"
                        HorizontalAlignment="Left" Padding="12,8"
                        Style="{DynamicResource HandySecondaryButton}"
                        ToolTip="Restore the default Base URL, model, and prompt (keys are kept)"
                        Click="ResetButton_Click" />
            </StackPanel>
        </Border>

        <!-- Prompt library card -->
        <Border Style="{DynamicResource HandySettingCard}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="PROMPT LIBRARY" Style="{DynamicResource HandyCaptionSmall}"
                           Foreground="{DynamicResource HandyTextSecondary}" />

                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <ComboBox x:Name="PromptSelector" DockPanel.Dock="Right" MinWidth="200"
                              VerticalAlignment="Center" HorizontalAlignment="Right"
                              FontSize="13" Foreground="{DynamicResource HandyText}"
                              FontFamily="{DynamicResource HandyFontFamily}"
                              ToolTip="Saved prompts — picking one loads it into the editor"
                              SelectionChanged="PromptSelector_SelectionChanged" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Saved prompt" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="Pick a saved prompt to edit it below."
                                   FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button x:Name="SavePromptButton" Content="Save" Width="72"
                                Style="{DynamicResource HandyPrimaryButton}"
                                ToolTip="Save the editor text under this name (updates the prompt if it exists)"
                                Click="SavePromptButton_Click" />
                        <Button x:Name="DeletePromptButton" Content="Delete" Width="72" Margin="8,0,0,0"
                                Style="{DynamicResource HandySecondaryButton}"
                                ToolTip="Delete the selected saved prompt"
                                Click="DeletePromptButton_Click" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Name" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBox x:Name="PromptNameBox" Margin="0,4,0,0" MinWidth="200"
                                 Style="{DynamicResource HandyTextBox}"
                                 ToolTip="Prompt name (max 60 chars)" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="Active prompt text (max 2000 chars, blank to disable)"
                           FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource HandyText}" />
                <TextBox x:Name="PromptBox" Margin="0,4,0,4" MinHeight="100"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Style="{DynamicResource HandyTextBox}"
                         TextChanged="PromptBox_TextChanged" />
                <TextBlock x:Name="PromptHint" FontSize="12"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource HandyTextSecondary}"
                           Text="0/2000 characters" />
                <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource HandyTextSecondary}"
                           Text="Tip: blank disables the custom prompt. Otherwise the text is sent as the system instruction with every transcription." />
            </StackPanel>
        </Border>

        <!-- Footer -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="TestButton" Content="Test" Width="90" Margin="0,0,8,0"
                    Style="{DynamicResource HandyPrimaryButton}"
                    ToolTip="Send a test tone through the full pipeline"
                    Click="TestButton_Click" />
            <Button x:Name="SaveButton" Content="Save" Width="90" IsDefault="True"
                    Style="{DynamicResource HandySecondaryButton}"
                    Click="SaveButton_Click" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource HandyTextSecondary}" />
    </StackPanel>
</UserControl>
