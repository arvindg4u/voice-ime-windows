<UserControl x:Class="VoiceIme.Views.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <!-- General section (redesign): page title, then grouped cards — dictation
         hotkey capture, activation mode, sound devices, cancel key. Every
         x:Name and event handler the code-behind relies on is preserved;
         only layout and visuals change. Brushes resolve from
         Theme/HandyTheme.xaml via DynamicResource. -->
    <StackPanel>
        <TextBlock Text="General" Style="{DynamicResource HandyPageTitle}" />
        <TextBlock Text="Dictation hotkey, activation mode, microphone and sound devices."
                   Style="{DynamicResource HandyCaption}" />

        <!-- Hotkey card -->
        <Border Style="{DynamicResource HandySettingCard}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="DICTATION HOTKEY" Style="{DynamicResource HandyCaptionSmall}"
                           Foreground="{DynamicResource HandyTextSecondary}" />
                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border x:Name="HotkeyChip" CornerRadius="8" BorderThickness="1"
                                Padding="10,8" Cursor="Hand" VerticalAlignment="Center"
                                Focusable="True"
                                ToolTip="Click to record a new hotkey"
                                AutomationProperties.Name="Record a new dictation hotkey"
                                BorderBrush="{DynamicResource HandyCardBorder}"
                                Background="{DynamicResource HandyHoverBackground}"
                                MouseLeftButtonUp="HotkeyChip_Click"
                                KeyDown="HotkeyChip_KeyDown">
                            <TextBlock x:Name="HotkeyText" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource HandyText}"
                                       Text="Ctrl+Shift+Space" />
                        </Border>
                        <Button x:Name="ResetHotkeyButton" Content="Reset" Margin="8,0,0,0"
                                Padding="12,8" VerticalAlignment="Center"
                                Style="{DynamicResource HandySecondaryButton}"
                                ToolTip="Restore Ctrl+Shift+Space"
                                Click="ResetHotkeyButton_Click" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Dictation hotkey" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="Works from any app. Click the chip, press keys, release to save. Click elsewhere to cancel."
                                   FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="HotkeyError" FontSize="12" TextWrapping="Wrap"
                           Margin="0,4,0,0" Visibility="Collapsed"
                           Foreground="{DynamicResource HandyError}" />
            </StackPanel>
        </Border>

        <!-- Activation mode card -->
        <Border Style="{DynamicResource HandySettingCard}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="ACTIVATION MODE" Style="{DynamicResource HandyCaptionSmall}"
                           Foreground="{DynamicResource HandyTextSecondary}" />
                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <ComboBox x:Name="ActivationBox" DockPanel.Dock="Right" MinWidth="160"
                              VerticalAlignment="Center" HorizontalAlignment="Right"
                              FontSize="13" Foreground="{DynamicResource HandyText}"
                              FontFamily="{DynamicResource HandyFontFamily}"
                              SelectionChanged="ActivationBox_SelectionChanged" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Activation mode" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="Saved now; recording still toggles until the new engine lands."
                                   FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Sound card -->
        <Border Style="{DynamicResource HandySettingCard}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="SOUND" Style="{DynamicResource HandyCaptionSmall}"
                           Foreground="{DynamicResource HandyTextSecondary}" />

                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Right">
                        <ComboBox x:Name="MicBox" MinWidth="200"
                                  VerticalAlignment="Center"
                                  FontSize="13" Foreground="{DynamicResource HandyText}"
                                  FontFamily="{DynamicResource HandyFontFamily}"
                                  SelectionChanged="MicBox_SelectionChanged" />
                        <Button x:Name="RefreshMicButton" Content="&#x21BB;" Margin="8,0,0,0"
                                Padding="12,8" VerticalAlignment="Center"
                                Style="{DynamicResource HandySecondaryButton}"
                                ToolTip="Refresh microphone list"
                                AutomationProperties.Name="Refresh microphone list"
                                Click="RefreshMicButton_Click" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Microphone" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="Falls back to the system input when unset."
                                   FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <CheckBox x:Name="MuteCheck" DockPanel.Dock="Right"
                              VerticalAlignment="Center" HorizontalAlignment="Right"
                              Style="{DynamicResource HandyToggleSwitch}"
                              Click="MuteCheck_Click" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Mute while recording" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="Mutes system output so the mic does not pick it up. Stored for now."
                                   FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <Button x:Name="TestSoundButton" DockPanel.Dock="Right" Content="Test"
                            Padding="12,8" VerticalAlignment="Center" HorizontalAlignment="Right"
                            Style="{DynamicResource HandySecondaryButton}"
                            Click="TestSoundButton_Click" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Speaker test" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock x:Name="SoundStatus"
                                   Text="Plays a 1-second tone through the default output."
                                   FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <ComboBox x:Name="ChannelBox" DockPanel.Dock="Right" MinWidth="160"
                              VerticalAlignment="Center" HorizontalAlignment="Right"
                              FontSize="13" Foreground="{DynamicResource HandyText}"
                              FontFamily="{DynamicResource HandyFontFamily}"
                              SelectionChanged="ChannelBox_SelectionChanged" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Capture channel" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="Stored for now; capture still opens the default device format."
                                   FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Right">
                        <ComboBox x:Name="OutputBox" MinWidth="200"
                                  VerticalAlignment="Center"
                                  FontSize="13" Foreground="{DynamicResource HandyText}"
                                  FontFamily="{DynamicResource HandyFontFamily}"
                                  SelectionChanged="OutputBox_SelectionChanged" />
                        <Button x:Name="RefreshOutputButton" Content="&#x21BB;" Margin="8,0,0,0"
                                Padding="12,8" VerticalAlignment="Center"
                                Style="{DynamicResource HandySecondaryButton}"
                                ToolTip="Refresh output device list"
                                AutomationProperties.Name="Refresh output device list"
                                Click="RefreshOutputButton_Click" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Output device" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="Falls back to the system output when unset. Stored for now; playback still uses the default device."
                                   FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Slider x:Name="VolumeSlider" MinWidth="160" Minimum="0" Maximum="100"
                                VerticalAlignment="Center"
                                Style="{DynamicResource HandySlider}"
                                ValueChanged="VolumeSlider_ValueChanged" />
                        <TextBlock x:Name="VolumeValue" Width="44" Margin="8,0,0,0"
                                   VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource HandyText}"
                                   Text="100%" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Volume" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="Display gain for the recording level meter only — never changes capture gain."
                                   FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <CheckBox x:Name="FeedbackCheck" DockPanel.Dock="Right"
                              VerticalAlignment="Center" HorizontalAlignment="Right"
                              Style="{DynamicResource HandyToggleSwitch}"
                              Click="FeedbackCheck_Click" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Audio feedback" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="Plays a short tone after a successful paste."
                                   FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Cancel key card -->
        <Border Style="{DynamicResource HandySettingCard}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="CANCEL KEY" Style="{DynamicResource HandyCaptionSmall}"
                           Foreground="{DynamicResource HandyTextSecondary}" />
                <DockPanel Style="{DynamicResource HandySettingRow}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border x:Name="CancelHotkeyChip" CornerRadius="8" BorderThickness="1"
                                Padding="10,8" Cursor="Hand" VerticalAlignment="Center"
                                Focusable="True"
                                ToolTip="Click to record a new cancel key"
                                AutomationProperties.Name="Record a new cancel key"
                                BorderBrush="{DynamicResource HandyCardBorder}"
                                Background="{DynamicResource HandyHoverBackground}"
                                MouseLeftButtonUp="CancelHotkeyChip_Click"
                                KeyDown="CancelHotkeyChip_KeyDown">
                            <TextBlock x:Name="CancelHotkeyText" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource HandyText}"
                                       Text="Esc" />
                        </Border>
                        <Button x:Name="ResetCancelButton" Content="Reset" Margin="8,0,0,0"
                                Padding="12,8" VerticalAlignment="Center"
                                Style="{DynamicResource HandySecondaryButton}"
                                ToolTip="Restore Esc"
                                Click="ResetCancelButton_Click" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Cancel key" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource HandyText}" />
                        <TextBlock Text="Armed only while recording or uploading. Click the chip, press a key, release to save. Click elsewhere to cancel."
                                   FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="CancelHotkeyError" FontSize="12" TextWrapping="Wrap"
                           Margin="0,4,0,0" Visibility="Collapsed"
                           Foreground="{DynamicResource HandyError}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
