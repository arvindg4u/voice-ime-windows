<Window x:Class="VoiceIme.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice IME — History" Width="520" Height="480"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CopyButton" Content="Copy" Width="80" Margin="0,0,8,0" Click="CopyButton_Click"/>
            <Button x:Name="PinButton" Content="Pin" Width="80" Margin="0,0,8,0" Click="PinButton_Click"/>
            <Button x:Name="DeleteButton" Content="Delete" Width="80" Margin="0,0,8,0" Click="DeleteButton_Click"/>
            <Button x:Name="ClearButton" Content="Clear unpinned" Width="110" Click="ClearButton_Click"/>
        </StackPanel>
        <ListBox x:Name="ClipsList" DisplayMemberPath="Label" MouseDoubleClick="ClipsList_DoubleClick"/>
    </DockPanel>
</Window>
