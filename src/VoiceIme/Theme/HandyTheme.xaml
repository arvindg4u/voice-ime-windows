<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:VoiceIme">

    <!--
        Handy unified design-token system (redesign).

        Every brush below is defined with a light-theme color. At runtime,
        ThemeManager.ApplyTheme replaces the brush object for every key with
        the dark-theme equivalent, so all DynamicResource consumers update
        live. Consumers must use {DynamicResource HandyXxx} (never
        {StaticResource}) so theme flips propagate.

        Token roles (see Theme/ThemeManager.cs for the full contract and the
        light/dark color values):
          Surfaces: HandyBackground, HandySurface, HandySurfaceElevated
          Text:     HandyText, HandyTextSecondary, HandyTextDisabled
          Accent:   HandyAccent, HandyAccentHover, HandyAccentActive,
                    HandyAccentContainer
          Borders:  HandyBorder, HandyDivider, HandyCardBorder
          Status:   HandyError, HandyWarning
          Focus:    HandyFocusBorder, HandyInkDisabled
          Interaction: HandyHoverBackground, HandyActiveBackground
          Brand:    HandyLogoPrimary

        Legacy aliases (kept so existing consumers keep compiling):
          HandyCardBackground, HandySecondaryBackground, HandyMidGray.

        Design rules (docs/RESEARCH.md):
          - Dark surfaces are near-black gray, never pure #000000.
          - Dark text is off-white, never pure #FFFFFF (reduces glare).
          - Accent is desaturated + lightened on dark (no neon vibration).
          - Surfaces layer with clear value gaps for elevation.
    -->

    <!-- ====================================================================
         Semantic color brushes — light-theme defaults.
         ThemeManager swaps these at runtime for dark theme.
         ==================================================================== -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="HandyBackground" Color="#FBFBFB" />
    <SolidColorBrush x:Key="HandySurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HandySurfaceElevated" Color="#F8F8F8" />

    <!-- Text -->
    <SolidColorBrush x:Key="HandyText" Color="#0F0F0F" />
    <SolidColorBrush x:Key="HandyTextSecondary" Color="#5F5F5F" />
    <SolidColorBrush x:Key="HandyTextDisabled" Color="#C7C7C7" />

    <!-- Brand accent -->
    <SolidColorBrush x:Key="HandyAccent" Color="#DA5893" />
    <SolidColorBrush x:Key="HandyAccentHover" Color="#C44E7F" />
    <SolidColorBrush x:Key="HandyAccentActive" Color="#AE4372" />
    <SolidColorBrush x:Key="HandyAccentContainer" Color="#FDE9F0" />

    <!-- Borders -->
    <SolidColorBrush x:Key="HandyBorder" Color="#E5E5E5" />
    <SolidColorBrush x:Key="HandyDivider" Color="#E5E5E5" />

    <!-- Status -->
    <SolidColorBrush x:Key="HandyError" Color="#DC2626" />
    <SolidColorBrush x:Key="HandyWarning" Color="#D97706" />

    <!-- Focus & interaction -->
    <SolidColorBrush x:Key="HandyFocusBorder" Color="#DA5893" />
    <SolidColorBrush x:Key="HandyInkDisabled" Color="#C7C7C7" />
    <SolidColorBrush x:Key="HandyHoverBackground" Color="#EFEFEF" />
    <SolidColorBrush x:Key="HandyActiveBackground" Color="#FDE9F0" />

    <!-- Brand -->
    <SolidColorBrush x:Key="HandyLogoPrimary" Color="#FAA2CA" />

    <!-- Legacy aliases (theme values swap via ThemeManager). -->
    <SolidColorBrush x:Key="HandyCardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HandyCardBorder" Color="#33808080" />
    <SolidColorBrush x:Key="HandySecondaryBackground" Color="#33808080" />
    <SolidColorBrush x:Key="HandyMidGray" Color="#808080" />

    <FontFamily x:Key="HandyFontFamily">Segoe UI</FontFamily>

    <!-- ====================================================================
         Typography
         ==================================================================== -->
    <Style x:Key="HandyPageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HandyFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource HandyText}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="HandySectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HandyFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource HandyText}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="HandyBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HandyFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource HandyText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="HandyCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HandyFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource HandyTextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="HandyCaptionSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HandyFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource HandyTextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ====================================================================
         Toggle switch: 40x22 Windows-style pill with an animating knob.
         ColorAnimation "To" values are hardcoded hex because a Color cannot
         be bound to a brush DynamicResource; the track's base color remains
         dynamic via HandyTextDisabled.
         ==================================================================== -->
    <Style x:Key="HandyToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource HandyText}" />
        <Setter Property="FontFamily" Value="{DynamicResource HandyFontFamily}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="22" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource HandyFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Track"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(TranslateTransform.X)"
                                                         To="18" Duration="0:0:0.2" />
                                        <ColorAnimation Storyboard.TargetName="TrackFill"
                                                        Storyboard.TargetProperty="(SolidColorBrush.Color)"
                                                        To="#DA5893" Duration="0:0:0.2" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.2" />
                                        <ColorAnimation Storyboard.TargetName="TrackFill"
                                                        Storyboard.TargetProperty="(SolidColorBrush.Color)"
                                                        To="#808080" Duration="0:0:0.2" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Track" CornerRadius="11" Height="22" Width="40">
                            <Border.Background>
                                <SolidColorBrush x:Name="TrackFill" Color="#C7C7C7" Opacity="0.5" />
                            </Border.Background>
                        </Border>
                        <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" Margin="3,3,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <ContentPresenter Margin="44,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ====================================================================
         Focus visual: accent ring for keyboard navigation.
         ==================================================================== -->
    <Style x:Key="HandyFocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource HandyFocusBorder}" BorderThickness="1.5"
                            CornerRadius="3" Margin="-2" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         Navigation rail item: 44px tall, 10px radius; active = accent tint.
         ==================================================================== -->
    <Style x:Key="HandyNavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="44" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontFamily" Value="{DynamicResource HandyFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource HandyText}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource HandyFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                        <Grid>
                            <Border x:Name="ActiveFill" CornerRadius="10"
                                    Background="{DynamicResource HandyActiveBackground}"
                                    Visibility="Collapsed" />
                            <Border x:Name="HoverFill" CornerRadius="10"
                                    Background="{DynamicResource HandyHoverBackground}"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="12,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverFill" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="local:MainWindow.IsNavActive" Value="True">
                            <Setter TargetName="ActiveFill" Property="Background" Value="{DynamicResource HandyLogoPrimary}" />
                            <Setter TargetName="ActiveFill" Property="Opacity" Value="0.8" />
                            <Setter TargetName="ActiveFill" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         Buttons
         ==================================================================== -->
    <Style x:Key="HandyPrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource HandyAccent}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="FontFamily" Value="{DynamicResource HandyFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource HandyFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HandyAccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HandyAccentActive}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HandySecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource HandyText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource HandyDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="FontFamily" Value="{DynamicResource HandyFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource HandyFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HandyHoverBackground}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource HandyAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource HandyInkDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource HandyInkDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HandyDangerButton" TargetType="Button" BasedOn="{StaticResource HandySecondaryButton}">
        <Setter Property="Foreground" Value="{DynamicResource HandyError}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HandyError}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{DynamicResource HandyError}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HandyDashboardTile" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource HandyCardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HandyCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource HandyFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HandyHoverBackground}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource HandyAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         Text input (refined): subtle hairline, accent focus ring.
         ==================================================================== -->
    <Style x:Key="HandyTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource HandyText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CaretBrush" Value="{DynamicResource HandyAccent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource HandyAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HandyCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontFamily" Value="{DynamicResource HandyFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource HandyFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource HandyAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            <Setter Property="Foreground" Value="{DynamicResource HandyInkDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         Info bar: dismissible banner used for the first-run hint.
         ==================================================================== -->
    <Style x:Key="HandyInfoBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource HandyCardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HandyCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!--
        Settings card: 8px radius, 1px border. Uses HandyCardBackground /
        HandyCardBorder (legacy aliases that swap per theme).
    -->
    <Style x:Key="HandySettingCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource HandyCardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HandyCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!--
        Settings row: horizontal label + control, min height 48.
    -->
    <Style x:Key="HandySettingRow" TargetType="DockPanel">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <!--
        Group header: 12px, gray. Consumers uppercase the text.
    -->
    <Style x:Key="HandyGroupHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource HandyTextSecondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource HandyFontFamily}" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

    <!-- Legacy toggle (44x24 pill) — kept for callers that still reference it. -->
    <Style x:Key="HandyToggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource HandyText}" />
        <Setter Property="FontFamily" Value="{DynamicResource HandyFontFamily}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Track" Width="44" Height="24" CornerRadius="12"
                                Background="{DynamicResource HandyTextDisabled}" Opacity="0.4">
                            <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource HandyAccent}" />
                            <Setter TargetName="Track" Property="Opacity" Value="1" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HandySlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource HandyAccent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsSnapToTickEnabled" Value="False" />
        <Setter Property="TickPlacement" Value="None" />
    </Style>

</ResourceDictionary>
