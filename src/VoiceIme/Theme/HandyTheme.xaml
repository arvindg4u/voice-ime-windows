<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:VoiceIme.Theme">

    <!--
    ============================================================================
    Voice IME design system — brush keys, metrics and control styles.
    ============================================================================

    LAYERING (do not collapse it):

      1. PRIMITIVE   the brand hue (#DA5893) — exists only in Palette.cs.
      2. SEMANTIC    SurfaceCard, TextMuted, AccentInk, FocusRing … — the
                     brush keys below. Their values are placeholders; at
                     runtime ThemeManager.ApplyTheme rewrites every one of
                     them from Theme/Palette.cs so a live theme switch repaints
                     the whole app.
      3. COMPONENT   the *Button / *TextBox / *Toggle styles below, which
                     reference only layer-2 keys.

    RULES FOR CONSUMERS
      • Every colour reference must be a DynamicResource from layer 2.
        StaticResource resolves once at load and will NOT repaint on a theme
        swap — that bug class is what this rewrite removes.
      • No literal colours anywhere below layer 1. The three historical
        exceptions (hardcoded White on the primary button, the toggle knob and
        the overlay cancel glyph) are now OnAccent / SurfaceCard tokens.
      • Metrics come from DesignTokens (spacing, radii, heights, type ramp).
        Do not invent numbers; if a value is missing, add a token.

    The values written here are the LIGHT theme. ThemeManager overwrites them
    at startup even when the OS preference is light, so they only need to be
    correct for the first frame — but keeping them accurate means a headless
    or test-booted control still looks right.
    ============================================================================
    -->

    <!-- ======================================================================
         LAYER 2 — SEMANTIC BRUSHES (mirrors Palette.Light)
         ====================================================================== -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceCanvas" Color="#FAFAFA" />
    <SolidColorBrush x:Key="SurfaceCard" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSunken" Color="#F4F4F5" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#F1F1F3" />
    <SolidColorBrush x:Key="SurfaceSelected" Color="#FCE7F1" />
    <SolidColorBrush x:Key="SurfaceOverlay" Color="#FFFFFF" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5A5A5A" />
    <SolidColorBrush x:Key="TextMuted" Color="#68686A" />
    <SolidColorBrush x:Key="TextDisabled" Color="#868688" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentFill" Color="#DA5893" />
    <SolidColorBrush x:Key="AccentFillHover" Color="#CE4F89" />
    <SolidColorBrush x:Key="AccentFillPressed" Color="#CD538A" />
    <SolidColorBrush x:Key="OnAccent" Color="#1A1114" />
    <SolidColorBrush x:Key="AccentInk" Color="#A63A6A" />
    <SolidColorBrush x:Key="AccentSubtle" Color="#FCE7F1" />

    <!-- Lines and focus -->
    <SolidColorBrush x:Key="BorderSubtle" Color="#E6E6E8" />
    <SolidColorBrush x:Key="BorderStrong" Color="#86868B" />
    <SolidColorBrush x:Key="FocusRing" Color="#A63A6A" />

    <!-- Status -->
    <SolidColorBrush x:Key="ErrorText" Color="#B3261E" />
    <SolidColorBrush x:Key="ErrorSurface" Color="#FCEBEA" />
    <SolidColorBrush x:Key="OnError" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WarningText" Color="#8A5300" />
    <SolidColorBrush x:Key="WarningSurface" Color="#FFF4E0" />
    <SolidColorBrush x:Key="OnWarning" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SuccessText" Color="#1E6E3C" />
    <SolidColorBrush x:Key="SuccessSurface" Color="#E6F4EA" />
    <SolidColorBrush x:Key="OnSuccess" Color="#FFFFFF" />

    <!--
        LEGACY ALIASES — kept only so not-yet-migrated views still compile and
        still theme correctly. Each points at its semantic replacement.
        New code must not use these; Palette.LegacyAliases is the same list and
        is asserted to only ever shrink.
    -->
    <SolidColorBrush x:Key="HandyText" Color="#1A1A1A" />
    <SolidColorBrush x:Key="HandyMidGray" Color="#68686A" />
    <SolidColorBrush x:Key="HandyBackground" Color="#FAFAFA" />
    <SolidColorBrush x:Key="HandyCardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HandyCardBorder" Color="#E6E6E8" />
    <SolidColorBrush x:Key="HandySecondaryBackground" Color="#F4F4F5" />
    <SolidColorBrush x:Key="HandyAccent" Color="#DA5893" />
    <SolidColorBrush x:Key="HandyLogoPrimary" Color="#DA5893" />
    <SolidColorBrush x:Key="HandyError" Color="#B3261E" />
    <SolidColorBrush x:Key="HandyWarning" Color="#8A5300" />

    <!-- ======================================================================
         TYPOGRAPHY
         ====================================================================== -->

    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI, Segoe UI Emoji, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>
    <!-- Legacy alias. -->
    <FontFamily x:Key="HandyFontFamily">Segoe UI Variable Text, Segoe UI, Segoe UI Emoji, sans-serif</FontFamily>

    <!-- Type ramp as reusable styles. -->
    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TextRowTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style x:Key="TextTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!-- ======================================================================
         SHARED PRIMITIVES
         ====================================================================== -->

    <!-- Keyboard focus: a 2px ring outside the control, always visible.
         Every focusable template below uses this so focus is never invisible
         (WCAG 2.4.7 / 2.4.11). -->
    <Style x:Key="FocusVisualRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="10"
                            BorderThickness="2"
                            BorderBrush="{DynamicResource FocusRing}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================================
         BUTTONS
         ====================================================================== -->

    <!-- Primary: accent fill with OnAccent (near-black) ink.
         Note: white ink on this pink is 3.62:1 and fails AA — the dark ink is
         a deliberate, contrast-verified choice, not a styling accident. -->
    <Style x:Key="PrimaryButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource AccentFill}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisualRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AccentFillHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AccentFillPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary: sunken fill, strong border, hover tint. -->
    <Style x:Key="SecondaryButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisualRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource SurfaceHover}" />
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource SurfaceSunken}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger: red fill with white ink (4.83:1 in light, 6.96:1 in dark),
         so unlike the brand accent it can carry white text. -->
    <Style x:Key="DangerButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource OnError}" />
        <Setter Property="Background" Value="{DynamicResource ErrorText}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisualRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hero: taller primary for the first-run/primary action. -->
    <Style x:Key="HeroButton" TargetType="ButtonBase" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Icon-only button: 32x32, square, no chrome until hover. Requires an
         AutomationProperties.Name on the instance — there is no visible label. -->
    <Style x:Key="IconButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisualRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource SurfaceHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource SurfaceSunken}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================================
         TEXT INPUTS
         ====================================================================== -->

    <Style x:Key="InputTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentInk}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Focus doubles as its own ring: 2px accent ink. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource FocusRing}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource TextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.6" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Read-only selectable body text (history entries) — no chrome. -->
    <Style x:Key="SelectableText" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================================
         COMBO BOX — previously un-themed (fell back to light Aero2 chrome,
         which stayed white in dark mode). Fully templated here.
         ====================================================================== -->

    <ControlTemplate x:Key="ComboBoxToggleTemplate" TargetType="ToggleButton">
        <Border Background="Transparent" />
    </ControlTemplate>

    <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="4" Margin="2,1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource SurfaceSelected}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InputComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True" />
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Editable text path also renders the selection
                                 box; IsEditable stays false in this app. -->
                            <ContentPresenter x:Name="ContentSite"
                                              Grid.Column="0"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Path x:Name="Arrow" Grid.Column="1"
                                  VerticalAlignment="Center" Margin="8,0,0,0"
                                  Data="M 0 0 L 4 4 L 8 0"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Grid>
                        <ToggleButton Background="Transparent"
                                      BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False"
                                      ClickMode="Press"
                                      Template="{StaticResource ComboBoxToggleTemplate}" />
                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource SurfaceCard}"
                                    BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,4,0,0"
                                    Padding="2">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource FocusRing}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                            <Setter TargetName="Arrow" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================================
         TOGGLE (switch)
         ====================================================================== -->

    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisualRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <!-- Off: strong border on sunken fill, so the track is
                             visible against the card (was a 1.25:1 gray wash). -->
                        <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                                Background="{DynamicResource SurfaceSunken}"
                                BorderBrush="{DynamicResource BorderStrong}"
                                BorderThickness="1.5">
                            <Ellipse x:Name="Knob" Width="14" Height="14"
                                     Fill="{DynamicResource TextSecondary}"
                                     HorizontalAlignment="Left" Margin="3,0,0,0" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background"
                                    Value="{DynamicResource AccentFill}" />
                            <Setter TargetName="Track" Property="BorderBrush"
                                    Value="{DynamicResource AccentFill}" />
                            <Setter TargetName="Knob" Property="Fill"
                                    Value="{DynamicResource OnAccent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================================
         SLIDER — previously a no-op style (stock template ignored Foreground,
         so the volume slider showed default grey chrome with no accent).
         ====================================================================== -->

    <Style x:Key="AccentSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsSnapToTickEnabled" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisualRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2"
                                Background="{DynamicResource BorderSubtle}"
                                VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2"
                                                    Background="{DynamicResource AccentInk}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" Height="4" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{DynamicResource AccentFill}"
                                                     Stroke="{DynamicResource SurfaceCard}"
                                                     StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================================
         SCROLLBAR — previously un-themed (light scrollbars in dark mode).
         ====================================================================== -->

    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource BorderStrong}"
                            CornerRadius="3" Opacity="0.55" Margin="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarLineButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarLineButton}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarLineButton}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ======================================================================
         LIST (history) — previously raw inline styling with the WPF default
         blue selection; now themed.
         ====================================================================== -->

    <Style x:Key="HistoryListItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisualRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8" Padding="0">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource SurfaceSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HistoryList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource HistoryListItem}" />
    </Style>

    <!-- ======================================================================
         LAYOUT: cards, groups, rows
         ====================================================================== -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- A row inside a card: title/help on the left, control on the right.
         Usage:
           <Grid Style="{DynamicResource SettingsRow}">
             <StackPanel Grid.Column="0"> title + help </StackPanel>
             <ContentControl Grid.Column="1" ...control... />
           </Grid>
    -->
    <Style x:Key="SettingsRow" TargetType="Grid">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Group header: small caps, muted, with the divider the design calls for. -->
    <Style x:Key="GroupHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Margin" Value="0,20,0,8" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="Margin" Value="0,4,0,4" />
    </Style>

    <!-- Inline status message (success / error / warning). -->
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style x:Key="StatusSuccess" TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
        <Setter Property="Foreground" Value="{DynamicResource SuccessText}" />
    </Style>
    <Style x:Key="StatusError" TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
        <Setter Property="Foreground" Value="{DynamicResource ErrorText}" />
    </Style>

    <!-- Inline field error under an input. -->
    <Style x:Key="FieldError" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorText}" />
    </Style>

    <!-- ======================================================================
         LEGACY STYLE ALIASES — same reason as the legacy brush aliases.
         ====================================================================== -->

    <Style x:Key="HandyPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}" />
    <Style x:Key="HandySecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}" />
    <Style x:Key="HandyDangerButton" TargetType="Button" BasedOn="{StaticResource DangerButton}" />
    <Style x:Key="HandySettingCard" TargetType="Border" BasedOn="{StaticResource Card}" />
    <Style x:Key="HandySettingRow" TargetType="DockPanel">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style x:Key="HandyGroupHeader" TargetType="TextBlock" BasedOn="{StaticResource GroupHeader}" />
    <Style x:Key="HandyTextBox" TargetType="TextBox" BasedOn="{StaticResource InputTextBox}" />
    <Style x:Key="HandyToggle" TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}" />
    <Style x:Key="HandySlider" TargetType="Slider" BasedOn="{StaticResource AccentSlider}" />

</ResourceDictionary>