<Window x:Class="VoiceIme.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice IME — Settings" Width="900" Height="700"
        MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource HandyBackground}">
    <!--
        Redesigned shell (redesign): left 240px navigation rail with the app
        mark at the top and About pinned at the bottom (Windows 11 Settings
        convention), a constrained max-width scrollable content column, and a
        status footer. HandyNavButton and the first-run info bar now live in
        Theme/HandyTheme.xaml; HandyNavButton's active trigger reads the
        local:MainWindow.IsNavActive attached property so theme flips update
        live without code-behind brush math.
    -->
    <DockPanel LastChildFill="True">
        <!-- Footer: left = tray status, right = updates note + version. -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource HandyDivider}" BorderThickness="0,1,0,0"
                Background="{DynamicResource HandyBackground}">
            <DockPanel Margin="24,12">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                           Text="Voice IME — ready" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                               Text="Updates via Releases" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                               Margin="8,0,4,0" Text="•" />
                    <TextBlock x:Name="VersionText" FontSize="12"
                               Foreground="{DynamicResource HandyTextSecondary}" Text="v1.0.0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- First-run hint (Task 9): shown once until dismissed (SeenHint).
             Handy info bar with accent actions; kept above the scrollable
             content so it never scrolls away on first launch. -->
        <Border x:Name="FirstRunHintCard" DockPanel.Dock="Top" Margin="0,0,0,20"
                Style="{DynamicResource HandyInfoBar}" Visibility="Collapsed">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="FIRST RUN" Style="{DynamicResource HandyCaptionSmall}"
                               Margin="0,0,0,4" Foreground="{DynamicResource HandyTextSecondary}" />
                    <TextBlock x:Name="FirstRunHintText" FontSize="13"
                               Foreground="{DynamicResource HandyText}" TextWrapping="Wrap"
                               Text="Press Ctrl+Shift+Space to dictate." />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="FirstRunHintSettingsButton"
                            Style="{DynamicResource HandySecondaryButton}"
                            Content="Open settings" Margin="0,0,8,0"
                            Click="FirstRunHintSettingsButton_Click" />
                    <Button x:Name="FirstRunHintDismissButton"
                            Style="{DynamicResource HandySecondaryButton}"
                            Content="Dismiss" Click="FirstRunHintDismissButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Sidebar rail: app mark, nav items, divider, About at the bottom. -->
        <Border DockPanel.Dock="Left" Width="240"
                BorderBrush="{DynamicResource HandyDivider}" BorderThickness="0,0,1,0"
                Background="{DynamicResource HandyBackground}">
            <StackPanel>
                <StackPanel Margin="20,24,20,16">
                    <TextBlock Text="🎙️ Voice IME" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource HandyText}" />
                    <TextBlock Text="Dictation for Windows" FontSize="11"
                               Foreground="{DynamicResource HandyTextSecondary}"
                               CharacterSpacing="1" Margin="0,4,0,0" />
                </StackPanel>
                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource HandyDivider}"
                        Margin="16,4,16,8" />
                <StackPanel x:Name="NavPanel" />
            </StackPanel>
        </Border>

        <!-- Content: single scrollable column, constrained to ~1080px for
             readability on wide displays (Windows settings guideline). -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,0">
            <Border MaxWidth="1080" HorizontalAlignment="Center">
                <ContentControl x:Name="SectionHost" />
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
