<Window x:Class="VoiceIme.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VoiceIme"
        Title="Voice IME — Settings" Width="680" Height="570"
        MinWidth="680" MinHeight="570"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource HandyBackground}">
    <!-- Handy shell (Task 2): fixed 160px sidebar + scrollable content + footer.
         Per-section Views/* UserControls plug into SectionHost via NavigateTo
         (Tasks 3-5). Until then each section shows a placeholder. -->
    <Window.Resources>
        <!-- Sidebar nav item: transparent, 8px radius. Active = pink overlay
             @80% (reference bg-logo-primary/80); inactive hover = gray @20%
             (HandySecondaryBackground is #808080 @20%). All DynamicResource
             so ThemeManager.ApplyTheme updates live. -->
        <Style x:Key="HandyNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontFamily" Value="{DynamicResource HandyFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource HandyText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <Grid>
                                <Border x:Name="HoverFill" CornerRadius="8"
                                        Background="{DynamicResource HandySecondaryBackground}"
                                        Visibility="Collapsed" />
                                <Border x:Name="ActiveFill" CornerRadius="8"
                                        Background="{DynamicResource HandyLogoPrimary}"
                                        Opacity="0.8"
                                        Visibility="Collapsed" />
                                <ContentPresenter Margin="8,6" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverFill" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="local:MainWindow.IsNavActive" Value="True">
                                <Setter TargetName="ActiveFill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- Footer: left = tray status, right = updates note + version. -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource HandyCardBorder}" BorderThickness="0,1,0,0"
                Background="{DynamicResource HandyBackground}">
            <DockPanel Margin="16,8">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource HandyMidGray}"
                           Text="Voice IME — ready" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="12" Foreground="{DynamicResource HandyMidGray}"
                               Text="Updates via Releases" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource HandyMidGray}"
                               Margin="4,0" Text="•" />
                    <TextBlock x:Name="VersionText" FontSize="12"
                               Foreground="{DynamicResource HandyMidGray}" Text="v1.0.0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Sidebar: 160px logo + nav. -->
        <Border DockPanel.Dock="Left" Width="160"
                BorderBrush="{DynamicResource HandyCardBorder}" BorderThickness="0,0,1,0"
                Background="{DynamicResource HandyBackground}">
            <StackPanel Margin="8,0">
                <TextBlock Margin="8,16,8,8" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource HandyText}" Text="🎙️ Voice IME" />
                <Border BorderBrush="{DynamicResource HandyCardBorder}" BorderThickness="0,1,0,0"
                        Margin="0,0,0,8" />
                <StackPanel x:Name="NavPanel" />
            </StackPanel>
        </Border>

        <!-- First-run hint (Task 9): shown once until dismissed (SeenHint).
             Fixed above the scrollable content; Handy card styling. -->
        <Border x:Name="FirstRunHintCard" DockPanel.Dock="Top" Margin="16,12,16,0"
                Style="{DynamicResource HandySettingCard}" Visibility="Collapsed">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="FIRST RUN" Style="{DynamicResource HandyGroupHeader}"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="FirstRunHintText" FontSize="13"
                               Foreground="{DynamicResource HandyText}" TextWrapping="Wrap"
                               Text="Press Ctrl+Shift+Space to dictate." />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="FirstRunHintSettingsButton"
                            Style="{DynamicResource HandySecondaryButton}"
                            Content="Open Settings" Margin="0,0,8,0"
                            Click="FirstRunHintSettingsButton_Click" />
                    <Button x:Name="FirstRunHintDismissButton"
                            Style="{DynamicResource HandySecondaryButton}"
                            Content="Dismiss" Click="FirstRunHintDismissButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content: 16px padding, scrollable; section UserControls go here. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <ContentControl x:Name="SectionHost" />
        </ScrollViewer>
    </DockPanel>
</Window>
