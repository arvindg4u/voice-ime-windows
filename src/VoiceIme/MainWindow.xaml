<Window x:Class="VoiceIme.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VoiceIme"
        Title="Voice IME — Settings"
        Width="900" Height="680"
        MinWidth="760" MinHeight="520"
        Icon="pack://application:,,,/VoiceIme;component/Assets/voiceime.ico"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource SurfaceCanvas}">

    <!--
      Shell layout.

      Sidebar (208px) | content

      The window used to be a fixed 680x570 with MinWidth == Width, so it could
      not be made smaller and the ~9-row General section always scrolled inside
      a 390px viewport. It now opens at 900x680, which fits the densest screen
      (General) without scrolling, and can be resized down to 760x520.

      Content lives in a ScrollViewer with a constrained column (max 720) so
      helper text keeps a readable measure instead of stretching across a wide
      monitor and wrapping into unreadable single lines.
    -->

    <Window.Resources>

        <!-- Sidebar navigation item. 40px tall to satisfy WCAG 2.5.8 (24x24
             minimum) with room for a 20px glyph, 8px gutter, 13px label.
             Active state is an attached property from code-behind so the
             trigger stays in XAML and survives theme swaps. -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisualRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource SurfaceHover}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="local:MainWindow.IsNavActive" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource SurfaceSelected}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentInk}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon tile in front of a nav label. -->
        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
        </Style>

        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ============================ FOOTER ============================ -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                Background="{DynamicResource SurfaceCanvas}">
            <Grid Margin="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Live status: tray state, save confirmations, errors.
                     Severity is set from code-behind via StatusSeverity so a
                     failure is not just a grey string (WCAG 1.4.1: never convey
                     state by colour alone — an icon accompanies it). -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextMuted}" Text="" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                               FontFamily="{DynamicResource UiFontFamily}" FontSize="12"
                               Foreground="{DynamicResource TextMuted}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Polite"
                               Text="Ready" />
                </StackPanel>

                <TextBlock x:Name="VersionText" Grid.Column="1" VerticalAlignment="Center"
                           FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                           Foreground="{DynamicResource TextMuted}" Text="v1.0.4" />
            </Grid>
        </Border>

        <!-- =========================== SIDEBAR =========================== -->
        <Border DockPanel.Dock="Left" Width="208"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0"
                Background="{DynamicResource SurfaceCanvas}">
            <DockPanel Margin="12,0">

                <!-- Brand row -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,20,8,16">
                    <Border Width="28" Height="28" CornerRadius="8"
                            Background="{DynamicResource AccentFill}" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" Text="&#xE720;"
                                   Foreground="{DynamicResource OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Voice IME" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontFamily="{DynamicResource UiFontFamily}" FontSize="14"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>

                <Border DockPanel.Dock="Top" Height="1" Margin="8,0,8,12"
                        Background="{DynamicResource BorderSubtle}" />

                <!-- Nav items (built in code-behind from MainNav) -->
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavPanel" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- =========================== CONTENT =========================== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- First-run card. Shown until dismissed; pinned above the
                 scroller so it cannot be scrolled away while setting up. -->
            <Border x:Name="FirstRunHintCard" Grid.Row="0" Margin="28,24,28,0"
                    Style="{DynamicResource Card}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                            Background="{DynamicResource AccentSubtle}" VerticalAlignment="Top">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16" Text="&#xE720;"
                                   Foreground="{DynamicResource AccentInk}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Set up Voice IME" FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock x:Name="FirstRunHintText" FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,3,0,0"
                                   Text="Add your Gemini API key, then press Ctrl+Shift+Space to dictate." />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="FirstRunHintSettingsButton"
                                Style="{DynamicResource PrimaryButton}"
                                Content="Add API key" Margin="0,0,8,0"
                                AutomationProperties.Name="Open speech settings to add your API key"
                                Click="FirstRunHintSettingsButton_Click" />
                        <Button x:Name="FirstRunHintDismissButton"
                                Style="{DynamicResource SecondaryButton}"
                                Content="Dismiss"
                                AutomationProperties.Name="Dismiss setup message"
                                Click="FirstRunHintDismissButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="28,20,28,28">
                <ContentControl x:Name="SectionHost" MaxWidth="720"
                                HorizontalAlignment="Left" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>