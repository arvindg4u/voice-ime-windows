<Window x:Class="VoiceIme.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceIMEOverlay" Width="256" Height="56"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <!--
        Redesigned compact pill (Task 6 contract preserved): 256x56, no
        decorations, always-on-top, taskbar-skipped, non-focusable. Left =
        status dot / spinner, center = waveform | "Sending…" | preview |
        error, right = timer + cancel. All brushes DynamicResource so
        ThemeManager.ApplyTheme flips live. Code-behind contract (Show,
        Hide, SetLevel, SetPreview, WorkAreaProvider) is unchanged.
    -->
    <Window.Resources>
        <Storyboard x:Key="DotPulse">
            <DoubleAnimation Storyboard.TargetName="StatusDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.4" Duration="0:0:1.1"
                             AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>
        <Storyboard x:Key="SpinnerSpin">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:0.7"
                             RepeatBehavior="Forever" />
        </Storyboard>
        <Style x:Key="OverlayCancelButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource HandyTextSecondary}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource HandyFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="12" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HandyHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource HandyText}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="28"
            Background="{DynamicResource HandyCardBackground}"
            BorderBrush="{DynamicResource HandyCardBorder}" BorderThickness="1"
            Padding="14,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: recording dot (pulsing) or uploading spinner. -->
            <Grid Grid.Column="0" Width="23" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="8" Height="8"
                         Fill="{DynamicResource HandyAccent}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse x:Name="Spinner" Width="14" Height="14" Visibility="Collapsed"
                         Fill="Transparent" Stroke="{DynamicResource HandyAccent}"
                         StrokeThickness="2" StrokeDashArray="2.5 1.8"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" CenterX="7" CenterY="7" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <!-- Center: waveform | "Sending…" | preview text | error (one visible). -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <StackPanel x:Name="WavePanel" Orientation="Horizontal" Height="20"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock x:Name="SendingLabel" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource HandyTextSecondary}"
                           Text="Sending…" />
                <TextBlock x:Name="PreviewText" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource HandyText}"
                           MaxWidth="160" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ErrorText" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource HandyError}"
                           MaxWidth="160" TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- Right: elapsed timer + cancel. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TimerText" VerticalAlignment="Center" Margin="0,0,8,0"
                           FontFamily="Consolas" FontSize="12"
                           Foreground="{DynamicResource HandyTextSecondary}"
                           Text="0:00" />
                <Button x:Name="CancelButton" Style="{StaticResource OverlayCancelButton}"
                        Content="✕" Click="OnCancelClick"
                        AutomationProperties.Name="Cancel recording" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
