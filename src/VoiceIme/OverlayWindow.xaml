<Window x:Class="VoiceIme.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceIMEOverlay" Width="256" Height="50"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <!-- Handy compact-pill port (Task 6): 256x50, no decorations, topmost,
         taskbar-skipped, non-focusable. Left = status dot / spinner,
         center = waveform | "Sending…" | error, right = timer + cancel.
         All brushes are DynamicResource so ThemeManager.ApplyTheme flips live. -->
    <Window.Resources>
        <Storyboard x:Key="DotPulse">
            <DoubleAnimation Storyboard.TargetName="StatusDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.35" Duration="0:0:0.95"
                             AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>
        <Storyboard x:Key="SpinnerSpin">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:0.7"
                             RepeatBehavior="Forever" />
        </Storyboard>
        <Style x:Key="OverlayCancelButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource HandyMidGray}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="11" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HandyAccent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="25"
            Background="{DynamicResource HandyCardBackground}"
            BorderBrush="{DynamicResource HandyCardBorder}" BorderThickness="1"
            Padding="12,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: recording dot (pulsing) or uploading spinner. -->
            <Grid Grid.Column="0" Width="23" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="7" Height="7"
                         Fill="{DynamicResource HandyAccent}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse x:Name="Spinner" Width="13" Height="13" Visibility="Collapsed"
                         Fill="Transparent" Stroke="{DynamicResource HandyAccent}"
                         StrokeThickness="2" StrokeDashArray="2.5 1.8"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" CenterX="6.5" CenterY="6.5" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <!-- Center: waveform | "Sending…" | error message (one visible). -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <StackPanel x:Name="WavePanel" Orientation="Horizontal" Height="18"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock x:Name="SendingLabel" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource HandyMidGray}"
                           Text="Sending…" />
                <TextBlock x:Name="ErrorText" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource HandyError}"
                           MaxWidth="130" TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- Right: elapsed timer + cancel. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TimerText" VerticalAlignment="Center" Margin="0,0,8,0"
                           FontFamily="Consolas" FontSize="12"
                           Foreground="{DynamicResource HandyMidGray}"
                           Text="0:00" />
                <Button x:Name="CancelButton" Style="{StaticResource OverlayCancelButton}"
                        Content="✕" Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
