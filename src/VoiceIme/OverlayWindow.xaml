<Window x:Class="VoiceIme.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceIMEOverlay" Width="256" Height="50"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <!-- Handy compact-pill port (Task 6): 256x50, no decorations, topmost,
         taskbar-skipped, non-focusable. Left = status dot / spinner,
         center = waveform | "Sending…" | error, right = timer + cancel.
         All brushes are DynamicResource so ThemeManager.ApplyTheme flips live. -->
    <Window.Resources>
        <Storyboard x:Key="DotPulse">
            <DoubleAnimation Storyboard.TargetName="StatusDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.35" Duration="0:0:0.95"
                             AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>
        <Storyboard x:Key="SpinnerSpin">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:0.7"
                             RepeatBehavior="Forever" />
        </Storyboard>
        <!-- Cancel: 28x28 satisfies the WCAG 2.5.8 24x24 minimum pointer
             target (it was 22x22). Hover ink is OnAccent, not a hardcoded
             White, so it stays legible against the accent in both themes. -->
        <Style x:Key="OverlayCancelButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="14"
                                Background="{DynamicResource SurfaceHover}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource AccentFill}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="25"
            Background="{DynamicResource SurfaceOverlay}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
            Padding="12,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: recording dot (pulsing) or uploading spinner. -->
            <Grid Grid.Column="0" Width="23" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="7" Height="7"
                         Fill="{DynamicResource AccentFill}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse x:Name="Spinner" Width="13" Height="13" Visibility="Collapsed"
                         Fill="Transparent" Stroke="{DynamicResource AccentFill}"
                         StrokeThickness="2" StrokeDashArray="2.5 1.8"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" CenterX="6.5" CenterY="6.5" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <!-- Center: waveform | interim preview | "Sending..." | error (one visible). -->
            <Grid Grid.Column="1" VerticalAlignment="Center">

                <!-- Interim transcript: a rolling tail. New words appear on the
                     right as you speak and old ones slide off the left, so what
                     is on screen is always the end of the sentence.

                     This replaced TextTrimming="CharacterEllipsis", which trims
                     the END — it kept the OLDEST words and hid the newest, so a
                     long dictation froze on an early fragment ending in "…"
                     while the user was still talking.

                     HorizontalScrollBarVisibility="Hidden" is deliberate rather
                     than "Disabled": Hidden constrains content to the viewport
                     and still allows programmatic scrolling, whereas Disabled
                     would make ScrollToHorizontalOffset a no-op. -->
                <ScrollViewer x:Name="PreviewScroll" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              ClipToBounds="True"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Focusable="False"
                              AutomationProperties.Name="Live transcription preview">
                    <!-- Leading-edge fade: words dissolve as they leave rather
                         than being guillotined by the clip, which is what makes
                         the motion read as "the old words disappearing" instead
                         of a hard cut. Purely decorative — the clip still
                         happens at the same place. -->
                    <ScrollViewer.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0.0" />
                            <GradientStop Color="#FF000000" Offset="0.12" />
                        </LinearGradientBrush>
                    </ScrollViewer.OpacityMask>
                    <TextBlock x:Name="PreviewText" TextWrapping="NoWrap"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               FontSize="12">
                        <!-- Settled text reads solid; the in-flight hypothesis is
                             dimmed, so the user can tell which words the model
                             has committed to and which are still provisional. -->
                        <Run x:Name="PreviewFinals"
                             Foreground="{DynamicResource TextPrimary}" /><Run
                            x:Name="PreviewInterim"
                            Foreground="{DynamicResource TextMuted}" />
                    </TextBlock>
                </ScrollViewer>

                <StackPanel x:Name="WavePanel" Orientation="Horizontal" Height="18"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock x:Name="SendingLabel" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource TextMuted}"
                           Text="Sending..." />
                <TextBlock x:Name="ErrorText" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource ErrorText}"
                           MaxWidth="130" TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- Right: elapsed timer + cancel. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TimerText" VerticalAlignment="Center" Margin="0,0,8,0"
                           FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           Text="0:00" />
                <Button x:Name="CancelButton" Style="{DynamicResource OverlayCancelButton}"
                        Content="✕" Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
